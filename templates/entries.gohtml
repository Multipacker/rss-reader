<!DOCTYPE html>

<html lang="en-us">
    <head>
        <title>RSS Feed</title>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <script src="/static/htmx.min.js@2.0.10"></script>
        <script src="/static/index.js"></script>
        <link rel="stylesheet" href="/static/style.css">
        <link rel="icon" href="/static/favicon.svg">
    </head>
    <body style="margin: 0;">
        <main style="display: flex; flex-direction: column; gap: 0.5em;">
            <h1 style="text-align: center; margin-bottom: 0;">RSS Feed</h1>

            <form style="display: flex; justify-content: center; flex-wrap: wrap; gap: 0.5em; margin-left: 0.5em; margin-right: 0.5em;" hx-target="#results" hx-swap="innerHTML scroll:top">
                <select id="search_filter" oninput="update_list();">
                    <option>Unread</option>
                    <option>Read</option>
                    <option>All</option>
                </select>
                <input id="search" name="query" style="flex: 1;" placeholder="Search..." type="search" hx-trigger="search, keyup changed delay:200ms" hx-post="/entries">
            </form>
            <div id="results">
                {{ template "entry_items.gohtml" . }}
            </div>
        </main>
    </body>
</html>

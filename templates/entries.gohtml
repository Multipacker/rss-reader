<!DOCTYPE html>

<html lang="en-us">
    <head>
        <title>RSS Feed</title>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/static/style.css">
        <link rel="icon" href="/static/favicon.svg">
        <script src="/static/htmx@2.0.10.min.js"></script>
        <script src="/static/index.js"></script>
    </head>
    <body style="margin: 0;">
        <main style="display: flex; flex-direction: column; gap: 0.5em;">
            <h1 style="text-align: center; margin-bottom: 0;">RSS Feed</h1>

            <form style="display: flex; justify-content: center; flex-wrap: wrap; gap: 0.5em; margin-left: 0.5em; margin-right: 0.5em;" hx-target="#results" hx-swap="innerHTML scroll:top">
                <select name="order" hx-post="/entries">
                    <option value="newest">Newest first</option>
                    <option value="oldest">Oldest first</option>
                </select>
                <select id="search_filter" hx-post="/entries">
                    <option>Unread</option>
                    <option>Read</option>
                    <option>All</option>
                </select>
                <input name="query" style="flex: 1;" placeholder="Search..." type="search" hx-trigger="search, keyup changed delay:200ms" hx-post="/entries">
            </form>

            <div id="results">
                <span
                    class="item"
                    style="text-align: center;"
                    hx-trigger="load"
                    hx-swap="outerHTML"
                    hx-post="/entries"
                    hx-include="form > *"
                    >
                    Loading...
                </span>
            </div>
        </main>
    </body>
</html>
